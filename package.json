{
  "name": "unofficial-gmi-cloud-cli",
  "version": "0.2.0",
  "description": "Unofficial GMI Cloud CLI (+ MCP server) for GMI Studio — image/video/audio generation and LLM inference",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannan000/unofficial-gmi-cloud-cli.git"
  },
  "type": "module",
  "bin": {
    "gmi": "dist/cli.js",
    "gmi-studio-mcp": "dist/mcp-server.js"
  },
  "main": "dist/client.js",
  "scripts": {
    "build": "tsc",
    "dev:mcp": "tsx src/mcp-server.ts",
    "dev:cli": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
